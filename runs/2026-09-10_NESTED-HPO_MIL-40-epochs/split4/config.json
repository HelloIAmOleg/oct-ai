{
  "data": {
    "batch_size": 2,
    "dataset_type": "MIL",
    "dataset": {
      "transforms": {
        "p_augs": 1.0,
        "rot_angles": [
          -5.581648175343511,
          5.581648175343511
        ],
        "random_state": 42,
        "normalize": true
      }
    }
  },
  "model": {
    "model": {
      "model_type": "MIL",
      "backbone": "timm/resnet34.tv_in1k",
      "drop_path_rate": 0.07261295347057163
    },
    "optimizer": {
      "type": "AdamW",
      "lr": 3e-06,
      "weight_decay": 0.0017580608553016777
    },
    "scheduler": {
      "type": "reduce_on_plateau",
      "scheduler_params": {
        "mode": "max",
        "factor": 0.5,
        "patience": 12,
        "verbose": true
      }
    }
  },
  "callbacks": [
    {
      "type": "model_checkpoint",
      "monitor": "val/f1__macro",
      "mode": "max",
      "verbose": true,
      "save_last": false
    },
    {
      "type": "early_stop",
      "monitor": "val/f1__macro",
      "mode": "max",
      "verbose": true,
      "patience": 25,
      "stopping_threshold": 0.99
    },
    {
      "type": "lr_monitor",
      "logging_interval": "epoch"
    }
  ]
}